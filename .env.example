PROJECT_NAME=DiabetesNHANES
MODEL_PATH=data/06_models/model.pkl
METRICS_PATH=data/08_reporting/metrics.json
DATABASE_URL=sqlite:///data/diabetes_nhanes.db
API_PORT=8000
DASHBOARD_PORT=8501

# --- API (opcional; valores por defecto si se omiten) ---
# Orígenes permitidos para CORS (separados por coma) — el front los necesita.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
# Umbral de decisión y bandas de riesgo de /predict.
DECISION_THRESHOLD=0.5
RISK_BAND_LOW=0.33
RISK_BAND_HIGH=0.66
# Límite de filas por lote en /predict/batch.
MAX_BATCH_ROWS=1000
